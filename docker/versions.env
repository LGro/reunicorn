# Reunicorn container build — pinned tool versions, single source of truth.
#
# Every line is `KEY="value"` (no spaces around =) so this file can be sourced by
# shell and parsed trivially by anything else. Consumed by:
#   docker/Dockerfile          via --build-arg (see docker/build-apk.sh)
#   docker/build-apk.sh        source
#   docker/check-versions.sh   source  (verifies these against the real sources)
#   .github/workflows/android.yaml
#
# Each value is derived from a source of truth elsewhere in the tree; that
# derivation is what check-versions.sh enforces. Do not edit a value here
# without changing (or checking) the source named in its comment.

# --- Flutter / Dart ---
# Source of truth: .fvmrc  (must also be >= veilid's FLUTTER_MIN_VERSION)
FLUTTER_VERSION="3.44.8"

# --- Java ---
# Source of truth: android/app/build.gradle (sourceCompatibility / jvmTarget).
# Note this is deliberately higher than veilid's JAVA_VERSION=17, which is only
# a floor for veilid itself.
JAVA_VERSION="21"

# --- Rust ---
# Source of truth: ../veilid/veilid-flutter/rust/rust-toolchain.toml.
# native_toolchain_rust rejects the stable/beta/nightly channels, so this must be
# an exact version, not a channel name.
RUST_VERSION="1.92.0"

# --- Android SDK ---
# NDK        source of truth: android/app/build.gradle (ndkVersion)
# Platforms  36 = reunicorn's compileSdkVersion, also what the veilid-flutter
#            android module compiles against via flutter.compileSdkVersion.
#            35 is pulled in by plugin modules; pinning it keeps Gradle from
#            downloading it mid-build.
#            Not 37: Google publishes only "platforms;android-37.0", whose
#            metadata reports API level 0 to the SDK tooling, so AGP cannot
#            resolve it. See the comment in android/app/build.gradle.
# Build-tools 36.0.0 is what AGP 8.13 requires; veilid still pins 35.0.0, so
#            check-versions.sh treats their value as a floor, not an equality.
# cmake / cmdline-tools: veilid's .dagger/versions.env.
# cmake is required — veilid-flutter/android uses externalNativeBuild.
ANDROID_NDK_VERSION="28.2.13676358"
ANDROID_PLATFORM_VERSIONS="35 36"
ANDROID_BUILD_TOOLS_VERSIONS="35.0.0 36.0.0"
ANDROID_CMAKE_VERSIONS="3.22.1 4.0.2"
ANDROID_CMDLINE_TOOLS_VERSION="13114758"

# --- Veilid ---
# pubspec.yaml depends on ../veilid/veilid-flutter by path, so this pin decides
# which veilid the app is actually built against. A tag or a full SHA both work.
# 76b2176 is v0.5.7-5-g76b21769.
VEILID_REPO="https://gitlab.com/veilid/veilid.git"
VEILID_REF="76b2176926dc24e30f9427540384a04ae22e590c"
